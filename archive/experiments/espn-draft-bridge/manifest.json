{
  "manifest_version": 3,
  "name": "FF Copilot ESPN Draft Bridge",
  "version": "1.1.0",
  "description": "Reads ESPN's persistent draft board and syncs complete pick snapshots to FF Copilot.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://*.fantasy.espn.com/*",
    "https://ff-copilot.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://*.fantasy.espn.com/*"
      ],
      "js": ["dom-parser.js", "espn-dom.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ff-copilot.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [],
  "action": {
    "default_title": "FF Copilot ESPN Draft Bridge",
    "default_popup": "popup.html"
  }
}
